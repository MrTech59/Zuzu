APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Bearer token required on /api/v1 (except /health) when set, or when APP_ENV != development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZUZU_API_KEY=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model is configurable; e.g. meta/llama-3.3-70b-instruct
NVIDIA_MODEL=

DATABASE_URL=postgresql+psycopg://zuzu:change-me@db:5432/zuzu

# MCP (browser tool server). Disabled until endpoint/transport verified.
# Verified during v0.1.0 development: Streamable HTTP at http://192.168.3.137:8000/mcp
ZUZU_MCP_ENABLED=false
ZUZU_MCP_SERVER_URL=
ZUZU_MCP_TRANSPORT=
ZUZU_MCP_CONNECT_TIMEOUT_SECONDS=10
ZUZU_MCP_REQUEST_TIMEOUT_SECONDS=30

TASK_MAX_STEPS=12
TASK_TIMEOUT_SECONDS=600
APPROVAL_TTL_SECONDS=900
