APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# AI provider: "mock" for offline development, "nvidia" for live NVIDIA chat.
# The mock provider returns deterministic responses without external API calls.
AI_PROVIDER=mock

# Comma-separated origins allowed to call the API from a browser.
# In Tailscale-only deployments add https://<zuzu-tailnet>:3000.
ZUZU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bearer token required on /api/v1 (except /health) when set, or when APP_ENV != development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ZUZU_API_KEY=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model identifier passed to the NVIDIA chat/completions endpoint.
# Default: nvidia/nemotron-3.5-lightning-30b-a3b
# Example alternatives (availability depends on your key's entitlements):
#   NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_MODEL=

# Database URL. Default is a local SQLite file for host development.
# For Docker/production, use scripts/setup.ps1 or scripts/setup.sh, which
# rewrite this to point at the PostgreSQL container.
DATABASE_URL=sqlite+aiosqlite:///./zuzu-dev.db

# PostgreSQL superuser/password. Only used by the Docker Compose database
# service; for host dev with SQLite this can be left empty.
# Generate with: python -c "import secrets, string; print(''.join(secrets.choice(string.ascii_letters + string.digits) for _ in range(32)))"
POSTGRES_PASSWORD=

# Web frontend API URL. The first-run wizard can override this in the browser.
NEXT_PUBLIC_ZUZU_API_URL=http://127.0.0.1:8000/api/v1

# MCP (browser tool server). Disabled until endpoint/transport verified.
# Verified during v0.1.0 development: Streamable HTTP at http://192.168.3.137:8000/mcp
ZUZU_MCP_ENABLED=false
ZUZU_MCP_SERVER_URL=
ZUZU_MCP_TRANSPORT=
ZUZU_MCP_CONNECT_TIMEOUT_SECONDS=10
ZUZU_MCP_REQUEST_TIMEOUT_SECONDS=30

TASK_MAX_STEPS=12
TASK_TIMEOUT_SECONDS=600
APPROVAL_TTL_SECONDS=900
